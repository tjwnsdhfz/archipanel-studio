{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archipanel.local/schemas/panel-project-v1.1.schema.json",
  "title": "ArchiPanel Studio Project 1.1",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "defaultDpi", "colorMode", "boards", "elements", "assets", "fonts", "contentBlocks", "typographyStyles", "layoutProposals", "presentationSpecs", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": "1.1" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "defaultDpi": { "type": "integer", "minimum": 72, "maximum": 1200 },
    "colorMode": { "const": "RGB" },
    "boards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/board" } },
    "elements": { "type": "array", "items": { "type": "object", "required": ["id", "boardId", "type", "xMm", "yMm", "widthMm", "heightMm"] } },
    "assets": { "type": "array" }, "fonts": { "type": "array" },
    "contentBlocks": { "type": "array", "items": { "$ref": "#/$defs/contentBlock" } },
    "typographyStyles": { "type": "array", "minItems": 4 },
    "layoutProposals": { "type": "array" }, "presentationSpecs": { "type": "array" },
    "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "printProfile": { "type": "object", "required": ["targetDpi", "viewingDistanceMm", "derivedWidthPx", "derivedHeightPx"], "properties": { "targetDpi": { "type": "integer", "minimum": 72, "maximum": 1200 }, "viewingDistanceMm": { "type": "number", "minimum": 0 }, "derivedWidthPx": { "type": "integer", "minimum": 1 }, "derivedHeightPx": { "type": "integer", "minimum": 1 } } },
    "board": { "type": "object", "required": ["id", "name", "widthMm", "heightMm", "bleedMm", "safeMarginMm", "grid", "guides", "elementIds", "printProfile"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "widthMm": { "type": "number", "exclusiveMinimum": 0 }, "heightMm": { "type": "number", "exclusiveMinimum": 0 }, "bleedMm": { "type": "number", "minimum": 0 }, "safeMarginMm": { "type": "number", "minimum": 0 }, "grid": { "type": "object" }, "guides": { "type": "array" }, "elementIds": { "type": "array" }, "printProfile": { "$ref": "#/$defs/printProfile" } } },
    "contentBlock": { "type": "object", "required": ["id", "boardId", "elementIds", "label", "title", "summary", "readingOrder", "importance", "confidence", "status"], "properties": { "id": { "type": "string" }, "boardId": { "type": "string" }, "elementIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "label": { "type": "string" }, "title": { "type": "string" }, "summary": { "type": "string" }, "readingOrder": { "type": "integer", "minimum": 1 }, "importance": { "type": "integer", "minimum": 1, "maximum": 5 }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "status": { "enum": ["suggested", "approved", "needs_review"] } } }
  }
}
