{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archipanel.local/schemas/panel-project-v1.4.schema.json",
  "title": "ArchiPanel Studio Project 1.4",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "defaultDpi", "colorMode", "boards", "elements", "assets", "fonts", "contentBlocks", "critiqueSettings", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": "1.4" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "defaultDpi": { "type": "integer", "minimum": 72, "maximum": 1200 },
    "colorMode": { "const": "RGB" },
    "boards": { "type": "array", "minItems": 1 },
    "elements": { "type": "array" }, "assets": { "type": "array" }, "fonts": { "type": "array" },
    "contentBlocks": { "type": "array" }, "layoutProposals": { "type": "array" },
    "critiqueSettings": {
      "type": "object",
      "required": ["enabled", "view", "showDensity", "showGaze", "showHierarchy", "projectPreferenceAdjustments"],
      "properties": {
        "enabled": { "type": "boolean" },
        "view": { "enum": ["original", "grayscale", "thumbnail", "blur"] },
        "showDensity": { "type": "boolean" }, "showGaze": { "type": "boolean" }, "showHierarchy": { "type": "boolean" },
        "projectPreferenceAdjustments": { "type": "object", "additionalProperties": { "type": "number", "minimum": -100, "maximum": 100 } }
      },
      "additionalProperties": false
    },
    "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" }
  }
}
